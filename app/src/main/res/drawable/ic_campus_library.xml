<?xml version="1.0" encoding="utf-8"?>
<!--
  图书馆图标：圆角方形底 + 书架剪影。

  用来做「图书馆预约」的入口卡片图标 —— 用户要求「呈正方形、整体靠左」。

  构图：
  - 底：靛蓝 → 蓝紫 的纵向渐变圆角方（radius 与卡片同比例，够圆润但不至于变胶囊）；
  - 图：四本**不等高**的书立在一条承板上。高低错落是关键 ——
    四本等高的书看起来像柱状图，不等高才有「书架」的语义。
  - 书与书之间留出均匀缝隙，靠底色透出分隔，不需要描边。

  24×24 的隐形设计栅格，换算到 108 viewport 是 ×4.5。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆角方形底：靛蓝 → 蓝紫 -->
    <path android:pathData="M24,0 L84,0 A24,24 0 0 1 108,24 L108,84 A24,24 0 0 1 84,108 L24,108 A24,24 0 0 1 0,84 L0,24 A24,24 0 0 1 24,0 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#4F6BF7"
                android:endColor="#8B5CF6" />
        </aapt:attr>
    </path>

    <!-- 书 1（偏矮） -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M18,37 L29,37 A2.2,2.2 0 0 1 31.2,39.2 L31.2,82 A2.2,2.2 0 0 1 29,84.2 L18,84.2 A2.2,2.2 0 0 1 15.8,82 L15.8,39.2 A2.2,2.2 0 0 1 18,37 Z" />

    <!-- 书 2（最高） -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M36,28 L47,28 A2.2,2.2 0 0 1 49.2,30.2 L49.2,82 A2.2,2.2 0 0 1 47,84.2 L36,84.2 A2.2,2.2 0 0 1 33.8,82 L33.8,30.2 A2.2,2.2 0 0 1 36,28 Z" />

    <!-- 书 3（最矮，制造节奏） -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M54,41 L65,41 A2.2,2.2 0 0 1 67.2,43.2 L67.2,82 A2.2,2.2 0 0 1 65,84.2 L54,84.2 A2.2,2.2 0 0 1 51.8,82 L51.8,43.2 A2.2,2.2 0 0 1 54,41 Z" />

    <!-- 书 4（次高） -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M72,33 L83,33 A2.2,2.2 0 0 1 85.2,35.2 L85.2,82 A2.2,2.2 0 0 1 83,84.2 L72,84.2 A2.2,2.2 0 0 1 69.8,82 L69.8,35.2 A2.2,2.2 0 0 1 72,33 Z" />

    <!-- 底部承板 -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M16.5,84.2 L91.5,84.2 A2.7,2.7 0 0 1 94.2,86.9 L94.2,88.7 A2.7,2.7 0 0 1 91.5,91.4 L16.5,91.4 A2.7,2.7 0 0 1 13.8,88.7 L13.8,86.9 A2.7,2.7 0 0 1 16.5,84.2 Z" />
</vector>
