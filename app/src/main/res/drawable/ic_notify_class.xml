<?xml version="1.0" encoding="utf-8"?>
<!--
    上课提醒的状态栏 / 灵动岛图标。

    Android 的通知小图标有硬性约束：系统只取 alpha 通道并按主题色重新着色
    （深色状态栏上呈现为纯白），因此这里**只画纯白剪影**。

    ## 设计取舍（两轮真机验证后定稿）

    这个图标在状态栏胶囊里实际只有约 20px。前两版都在追求「书 + 时钟」的
    复合造型，但缩小后：
    - 描边式书页 → 两片细线，糊成两个"C"；
    - 右下角时钟 → 挤进书的轮廓里，变成一个污点。

    结论：**20px 只能承载一个形状**。最终定稿用最简的「实心翻开的书」：
    两块饱满的页块 + 中间一道干净的中缝，轮廓尽可能贴满 24dp 画布。
    造型本身就能读懂「课程」，不需要再叠加时钟。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 左页：饱满的圆角页块，贴着画布左边 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.7,4.9c-1.9,-1 -4.1,-1.4 -6.3,-1.1c-0.6,0.1 -1.0,0.6 -1.0,1.2v13.2c0,0.7 0.6,1.2 1.3,1.2c2.0,-0.1 3.8,0.3 5.0,1.1c0.3,0.2 0.7,0.3 1.0,0.3z" />

    <!-- 右页：与左页镜像，中缝留白 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M13.3,4.9c1.9,-1 4.1,-1.4 6.3,-1.1c0.6,0.1 1.0,0.6 1.0,1.2v13.2c0,0.7 -0.6,1.2 -1.3,1.2c-2.0,-0.1 -3.8,0.3 -5.0,1.1c-0.3,0.2 -0.7,0.3 -1.0,0.3z" />
</vector>
